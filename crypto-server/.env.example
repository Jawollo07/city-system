# Copy to .env outside version control; generate secrets with a cryptographically secure generator.
# Admin token is for KMS management endpoints only.
API_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN_AT_LEAST_32_CHARS

# Optional seed map of computer IDs to unique, random per-device tokens.
# Prefer adding devices through the admin API, which displays a new token once.
# Every seeded token must be at least 32 characters. Keep this file private.
DEVICE_TOKENS_JSON={}

# Adjust to match the actual computer IDs/labels in your world.
NETWORK_CONFIG_JSON={"ELEVATOR_NET":["18","22"],"DOORS_NET":["11","19"]}
DB_PATH=/data/keys.db
ROTATION_INTERVAL_HOURS=24
HOST=127.0.0.1
PORT=25560
LOG_LEVEL=INFO
