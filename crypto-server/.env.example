# Copy to .env outside version control; generate secrets with a cryptographically secure generator.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This one key is used by both crypto.lua and admin.lua for every API request.
API_TOKEN=REPLACE_WITH_RANDOM_SHARED_API_KEY

# Adjust to match the actual computer IDs/labels in your world.
NETWORK_CONFIG_JSON='{"ELEVATOR_NET":["18","22"],"DOORS_NET":["11","19"]}'
DB_PATH=/data/keys.db
ROTATION_INTERVAL_HOURS=24
HOST=127.0.0.1
PORT=25560
LOG_LEVEL=INFO
