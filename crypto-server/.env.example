# Generate each secret independently; never commit the real .env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Device clients can retrieve network keys, but cannot manage devices or rotate keys.
DEVICE_API_TOKEN=REPLACE_WITH_RANDOM_DEVICE_API_TOKEN
# Keep this token only on the admin terminal / trusted administration environment.
ADMIN_API_TOKEN=REPLACE_WITH_RANDOM_ADMIN_API_TOKEN

# Computer labels must exactly match a key in this mapping.
NETWORK_CONFIG_JSON='{"ELEVATOR_NET":["18", "22"], "DOORS_NET":["11", "19"]}'
DB_PATH=/data/keys.db
ROTATION_INTERVAL_HOURS=24
HOST=127.0.0.1
PORT=25560
LOG_LEVEL=INFO
